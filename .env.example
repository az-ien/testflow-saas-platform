# ═══════════════════════════════════════════════════════════════
# TestFlow SaaS Platform — Environment Configuration
# Copy to .env and fill in your values before running
# ═══════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
LOG_DIR=logs

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=testflow
DB_TEST_NAME=testflow_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── JWT Auth ────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Stripe Billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_xxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxx
STRIPE_PRICE_BUSINESS_MONTHLY=price_xxxxx
STRIPE_PRICE_STARTER_YEARLY=price_xxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxxxx

# ─── AWS S3 (test artifacts & reports) ───────────────────────
AWS_ACCESS_KEY_ID=xxxxx
AWS_SECRET_ACCESS_KEY=xxxxx
AWS_REGION=us-east-1
S3_BUCKET=testflow-artifacts

# ─── Sentry (error monitoring) ────────────────────────────────
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/xxxxx

# ─── SendGrid (email) ─────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxx
EMAIL_FROM=noreply@testflow.io
EMAIL_FROM_NAME=TestFlow

# ─── Worker ───────────────────────────────────────────────────
WORKER_CONCURRENCY=3
WORKER_JOB_TIMEOUT_MS=600000
# Max time a single test run can take (10 min default)
AI_WORKER_CONCURRENCY=2
ARTIFACT_DIR=/tmp/testflow-artifacts

# ─── AI Quality Engineering ───────────────────────────────────
# heuristic | openai | anthropic
AI_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
PLAYWRIGHT_MCP_ENABLED=false
PLAYWRIGHT_MCP_COMMAND=npx
PLAYWRIGHT_MCP_ARGS=@playwright/mcp
EXPLORATION_MAX_PAGES=6
EXPLORATION_TIMEOUT_MS=45000
FEATURE_AI_QE=true

# ─── Feature Flags ───────────────────────────────────────────
FEATURE_GITHUB_WEBHOOKS=true
FEATURE_GITLAB_WEBHOOKS=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_STRIPE_BILLING=false

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW_MS=60000

# ─── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=TestFlow
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
